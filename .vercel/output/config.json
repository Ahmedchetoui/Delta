{
  "version": 3,
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "s-maxage=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/service-worker.js",
      "headers": {
        "cache-control": "s-maxage=0"
      },
      "continue": true
    },
    {
      "src": "^/manifest\\.json$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "^/static(?:/(.*))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/sockjs-node/(.*)",
      "dest": "/sockjs-node/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "dest": "https://delta-n5d8.onrender.com/api/$1",
      "check": true
    },
    {
      "src": "^/uploads(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "dest": "https://delta-n5d8.onrender.com/uploads/$1",
      "check": true
    },
    {
      "src": "/static/(.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*)",
      "headers": {
        "cache-control": "s-maxage=0"
      },
      "dest": "/index.html"
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    }
  ],
  "framework": {
    "slug": "create-react-app",
    "version": "5.0.1"
  },
  "crons": []
}
