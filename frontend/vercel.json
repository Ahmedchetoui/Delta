{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://delta-n5d8.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://delta-n5d8.onrender.com/uploads/:path*"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
